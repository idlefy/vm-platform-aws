# shellcheck shell=bash disable=SC2154 # R comes from dev-vm-image-scrub
# The solo profile of dev-vm-image-scrub: Idlefy's hardened public image,
# converged once by image/files/bootstrap-solo (docs/design/hardened-image.md).
#
# SOURCED, never executed: `dev-vm-image-scrub --profile solo <sha256>` reads
# this file from its own directory and calls the three hooks below. It lives
# apart from the scrub because the scrub rides in every fleet VM's user data,
# which EC2 caps at 16 KB gzipped; only the solo build's user data embeds this
# file (installed as /usr/local/sbin/dev-vm-image-scrub-solo, 0755 root:root).
#
# Law A1: nothing baked into this image takes instructions from Idlefy after
# launch. So CINC is purged, and the image is refused (exit 70, named on the
# console, no cloud-init clean, no poweroff) unless every invariant holds.
#
# The lists are test/fixtures/image-scrub-paths-solo, verbatim; the reasons are
# there, and test/test-image-scrub.sh fails if the two drift.

# bootstrap-solo keeps the converge's state on tmpfs, off the disk.
# shellcheck disable=SC2034 # read by dev-vm-image-scrub
STATE=${DEV_VM_POLICY_STATE:-/run/dev-vm/solo}

REMOVE_SOLO=(
  "/etc/ssh/ssh_host_*" # host keys; regenerated on first boot
  "/var/lib/amazon/ssm/Vault" # SSM agent's registration for the build instance; a credential even with the snap gone
  "/var/lib/amazon/ssm/runtimeconfig/identity_config.json" # SSM agent's cached identity
  "/home/ubuntu/.local/share/docker/engine-id" # rootless dockerd's engine id
  "/home/ubuntu/.claude.json" # Claude Code's userID/machineID, created by its installer
  "/home/ubuntu/.claude/backups" # backups of that file
  "/var/lib/systemd/random-seed" # an RNG seed clones must not share
  "/var/lib/systemd/credential.secret" # systemd's per-host credential key; clones must not share it
  "/var/cache/pollinate/seeded" # so pollinate seeds each VM on first boot
  "/var/lib/dhcpcd/*" # the DHCP DUID and the build's lease
  "/home/ubuntu/.local/share/docker/containerd/daemon/io.containerd.grpc.v1.introspection/uuid" # rootless containerd's instance uuid
  "/home/ubuntu/.local/share/docker/buildkit/containerd-overlayfs/workerid" # rootless buildkit's worker id
  "/var/lib/docker/engine-id" # dockerd's engine id
  "/var/lib/docker/buildkit/containerd-overlayfs/workerid" # buildkit's worker id
  "/var/lib/containerd/io.containerd.grpc.v1.introspection/uuid" # containerd's instance uuid
  "/var/lib/fail2ban/fail2ban.sqlite3" # the build's ban database
  "/var/lib/systemd/timers/stamp-*" # stale stamps would fire apt-daily-upgrade during the first converge
  "/home/ubuntu/.ssh/authorized_keys" # Packer's temporary key pair, written by cloud-init
  "/root/.ssh/authorized_keys" # the same key, behind cloud-init's "login as ubuntu" prefix
  "/root/.gnupg" # gpg-agent state from apt key imports
  "/var/lib/tailscale/*" # tailscaled node state and logs
  "/var/cache/tailscale" # tailscaled cache
  "/var/lib/dev-vm/policy/*" # never created in solo; defensive
  "/opt/cinc" # apt-get purge cinc leaves nothing here; defensive
  "/etc/cinc" # cinc-client's config dir, if the purge leaves it
  "/root/.chef" # cinc-client's per-user state
  "/var/log/journal/*" # the build's journal
  "/var/log/user-data.log" # the build's bootstrap log
  "/var/log/cinc-first-run.log" # the build's converge log (bootstrap-solo writes it)
  "/var/log/*.gz" # rotated logs
  "/var/log/*.1" # rotated logs
  "/var/log/amazon/ssm/*" # SSM agent logs of the build
  "/var/log/sysstat/*" # the build's sysstat data
  "/var/log/apt/*" # the build's apt history
  "/var/log/unattended-upgrades/*" # the build's unattended-upgrades logs
  "/var/log/landscape/*" # the build's landscape logs
  "/home/ubuntu/.npm/_logs" # npm debug logs from the installs
  "/home/ubuntu/.bash_history" # none expected; defensive
  "/root/.bash_history" # none expected; defensive
  "/tmp/*" # install leftovers (uv tarball, node compile cache, sockets)
  "/var/tmp/*" # systemd private dirs
  "/var/lib/snapd" # snapd's state, device key and serial
  "/snap" # snap mount points
  "/var/snap" # per-snap data
  "/var/cache/snapd" # snapd's cache
  "/root/snap" # per-user snap data
  "/home/*/snap" # per-user snap data
  "/var/cache/apparmor/*/snap-confine*" # snap-confine's compiled AppArmor profiles, left by the purge (measured)
)
EMPTY_SOLO=(
  "/etc/machine-id" # systemd/journald identity; /var/lib/dbus/machine-id links here
  "/var/log/syslog" # the build's syslog
  "/var/log/auth.log" # the build's auth log
  "/var/log/kern.log" # the build's kernel log
  "/var/log/wtmp" # login records
  "/var/log/btmp" # failed logins
  "/var/log/lastlog" # last logins
  "/var/log/dpkg.log" # the build's package log
  "/var/log/fail2ban.log" # the build's fail2ban log
  "/var/log/dmesg" # the build's boot messages
)

# refuse WHAT: the same shape as the scrub's timer check before poweroff. A
# newline first: the serial console may sit at an unterminated getty prompt
# ("host login: "), and the build driver matches refusals at a line's start.
# A refusal during the zero-fill puts the ext4 reserve back first (best
# effort: the instance is terminated with its disk anyway).
RESV_KNOB="" RESV_SAVED=""
refuse() {
  [ -z "$RESV_KNOB" ] || printf '%s\n' "$RESV_SAVED" > "$RESV_KNOB" 2>/dev/null || true
  { echo > "$CONSOLE"; } 2>/dev/null || true
  log "internal error: $*; no image will be taken"
  exit 70
}

# Hook 1, before image-revision is written: without the directory that write
# would fail into the ERR trap, which names a line rather than the reason.
solo_dir() {
  [ -d "$R/etc/dev-vm" ] || refuse "/etc/dev-vm is not a directory (bootstrap-solo creates it)"
}

# Hook 2, after the stops and before the removals: purge CINC (fatal, never a
# note — an image with CINC on it is the thing law A1 forbids), check the SSM
# agent is gone, purge snapd, drop apt's package cache, then swap in the solo
# lists, which mop up whatever the purges leave.
# apt-get waits for a dpkg lock unattended-upgrades may still hold.
# The cinc-client and SSM-snap checks are here, not in solo_check: the lists
# remove /opt/cinc, /snap and /var/lib/snapd, so after them an absence would
# prove nothing.
solo_prep() {
  DEBIAN_FRONTEND=noninteractive apt-get purge -y -o DPkg::Lock::Timeout=300 cinc \
    || refuse "cinc purge failed"
  [ ! -e "$R/opt/cinc/bin/cinc-client" ] || refuse "cinc still installed (/opt/cinc/bin/cinc-client is on disk)"
  # The SSM agent is an inbound instruction channel; base::no_ssm_agent removed
  # its snap. `snap list` also fails when snapd is unreachable, so the disk is
  # checked as well — both before snapd's purge would hide a failed removal.
  if snap list amazon-ssm-agent >/dev/null 2>&1; then refuse "the amazon-ssm-agent snap is still installed"; fi
  if [ -e "$R/snap/amazon-ssm-agent" ] || compgen -G "$R/var/lib/snapd/snaps/amazon-ssm-agent_*.snap" >/dev/null; then
    refuse "the amazon-ssm-agent snap is still on disk"
  fi
  # snapd leaves: its state holds a device key and serial made on the build
  # instance, which every box would share; ubuntu has no sudo, so only the
  # admin could use snap at all (ruling 2026-11-20). solo_check proves it gone.
  # A second defence for that key, beside the zero-fill: overwrite it in
  # place before the purge unlinks it (ext4 rewrites a file's own blocks).
  # Best effort, never a refusal; no key directory is fine.
  if compgen -G "$R/var/lib/snapd/device/private-keys-v1/*" >/dev/null; then
    shred -u -- "$R"/var/lib/snapd/device/private-keys-v1/* || log "note: shred of the snapd device key failed; the purge and the zero-fill still run"
  fi
  DEBIAN_FRONTEND=noninteractive apt-get purge -y -o DPkg::Lock::Timeout=300 snapd \
    || refuse "snapd purge failed"
  # The package cache (321 MB on the first build); the lists stay.
  apt-get clean || refuse "apt-get clean failed"
  # shellcheck disable=SC2034 # read by dev-vm-image-scrub
  REMOVE=("${REMOVE_SOLO[@]}")
  # shellcheck disable=SC2034 # read by dev-vm-image-scrub
  EMPTY=("${EMPTY_SOLO[@]}")
}

# filter_has FILE ERE: a line of FILE's *filter table matches, and that table
# is closed by its COMMIT — iptables-restore applies no table it never sees
# committed, so a truncated file counts as no match, and so does a missing one.
filter_has() {
  awk -v re="$2" '
    /^\*/       { t = $0; m = 0 }
    t == "*filter" && $0 ~ re { m = 1 }
    /^COMMIT$/  { if (t == "*filter" && m) f = 1; t = ""; m = 0 }
    END         { exit !f }' "$R$1" 2>/dev/null
}

# meta_preamble_ok FILE ADDR EIC_UID: in every committed *filter table of FILE,
# each OUTPUT rule before the metadata drop (`-A OUTPUT -d ADDR -j DROP`,
# wherever it sits) is exactly one of base::imds's owner allows:
#   -A OUTPUT -d ADDR -m owner --uid-owner 0 -j ACCEPT
#   -A OUTPUT -d ADDR -m owner --uid-owner EIC_UID -j ACCEPT  (EIC_UID non-empty)
# An allowlist: anything else there — another uid, a negation, a gid match, a
# wider destination, a protocol accept, RETURN, a jump, a counter-prefixed
# line — fails, and so does an unreadable file. Rules after the drop are not
# restricted: the drop has already decided the metadata address.
meta_preamble_ok() {
  awk -v a="$2" -v eic="$3" '
    BEGIN       { root = "-A OUTPUT -d " a " -m owner --uid-owner 0 -j ACCEPT"
                  e = (eic ~ /^[0-9]+$/) ? "-A OUTPUT -d " a " -m owner --uid-owner " eic " -j ACCEPT" : "" }
    /^\*/       { t = $0; s = 0; d = 0 }
    t == "*filter" && $0 == "-A OUTPUT -d " a " -j DROP" { d = 1 }
    t == "*filter" && !d && index($0, "-A OUTPUT") && $0 != root && (e == "" || $0 != e) { s = 1 }
    /^COMMIT$/  { if (t == "*filter" && s) bad = 1; t = ""; s = 0; d = 0 }
    END         { exit bad }' "$R$1" 2>/dev/null
}

# dpkg_sane: dpkg's database knows dpkg itself as installed. An empty or
# missing database answers "no packages found" for everything, which
# pkg_absent would read as absence.
dpkg_sane() {
  local said
  # shellcheck disable=SC2016 # dpkg-query's format, not a shell expansion
  said=$(LC_ALL=C dpkg-query -W -f='${db:Status-Status}' dpkg 2>&1) \
    && [ "$said" = installed ] \
    || refuse "dpkg's database does not show dpkg itself installed (dpkg-query: '$(printf '%s' "$said" | head -n 1)'), so its answers prove nothing"
}

# pkg_absent NAME: dpkg knows no such package (dpkg-query exits 1 saying "no
# packages found matching"), or knows it as not-installed (what a purge
# leaves). Any other answer — installed, half-installed, config-files, an
# error, an unreadable database — is not absence.
# Its answer (status or error, one line) is left in PKG_SAID for the refusal.
PKG_SAID=""
pkg_absent() {
  local rc=0
  # shellcheck disable=SC2016 # dpkg-query's format, not a shell expansion
  PKG_SAID=$(LC_ALL=C dpkg-query -W -f='${db:Status-Status}' "$1" 2>&1) || rc=$?
  PKG_SAID=$(printf '%s' "$PKG_SAID" | head -n 1)
  case $rc in
    0) [ "$PKG_SAID" = not-installed ] ;;
    1) [[ $PKG_SAID == *"no packages found matching $1"* ]] ;;
    *) return 1 ;;
  esac
}

# no_units_left: no unit-shaped file or link of snapd, a snap or the SSM agent
# anywhere on the root filesystem — not a list of unit directories (every
# review found another search path; systemd reads units from many, and a
# user's own). One find over / with -xdev: it stays on the filesystem the
# snapshot images (/proc, /sys, /dev and /run are other filesystems on the
# instance, so -xdev, not a name, leaves them out; nothing is excluded by
# name). Links are matched as links and never followed: a unit behind a
# linked directory is found where it really lies, on this filesystem. A
# find error refuses.
no_units_left() {
  local hits
  hits=$(find "$R/" -xdev \( -type f -o -type l \) \
           \( -name 'snap*.service' -o -name 'snap*.socket' -o -name 'snap*.mount' -o -name 'snap*.timer' \
              -o -name 'snap*.target' -o -name 'snap*.path' -o -name 'snap*.slice' -o -name 'snap*.scope' \
              -o -name 'amazon-ssm-agent*' \) -print) \
    || refuse "cannot scan / for snap or SSM units"
  [ -z "$hits" ] || refuse "snap or SSM units are left: $(printf '%s' "$hits" | head -n 3 | tr '\n' ' ')"
}

# no_deleted_open: no process holds a deleted regular file of non-zero size on
# the root filesystem. Its blocks are freed only when the last holder closes
# it — at power-off, after the zero-fill — so they reach the snapshot as they
# were. Strict on purpose: the build is the place to find a new holder.
no_deleted_open() {
  local fd tgt info typ size dev rootdev pid hits=""
  rootdev=$(stat -c %d "$R/") || refuse "cannot stat /"
  [ -d "$R/proc/1/fd" ] || refuse "cannot read /proc"
  for fd in "$R"/proc/[0-9]*/fd/*; do
    tgt=$(readlink "$fd" 2>/dev/null) || continue   # the process or fd is gone
    [[ $tgt == *" (deleted)" ]] || continue
    info=$(stat -L -c '%F|%s|%d' "$fd" 2>/dev/null) || continue
    IFS='|' read -r typ size dev <<< "$info"
    [ "$typ" = "regular file" ] && [ "$size" -gt 0 ] && [ "$dev" = "$rootdev" ] || continue
    pid=${fd#"$R"/proc/}; pid=${pid%%/*}
    hits+="${tgt% (deleted)} ($size bytes, pid $pid $(cat "$R/proc/$pid/comm" 2>/dev/null || true)); "
  done
  [ -z "$hits" ] || refuse "files deleted but still open would be freed only at power-off, after the zero-fill: $hits"
}

# resv_knob: the ext4 reserved_clusters file of the filesystem holding /.
resv_knob() {
  local majmin dev
  majmin=$(mountpoint -d "$R/") || return 1
  dev=$(readlink -f "$R/sys/dev/block/$majmin") || return 1
  dev=${dev##*/}
  [ -n "$dev" ] && [ -f "$R/sys/fs/ext4/$dev/reserved_clusters" ] || return 1
  printf '%s\n' "$R/sys/fs/ext4/$dev/reserved_clusters"
}

# zero_fill: overwrite the free space of / with zeros, so blocks a removal
# freed (the snapd device key, the build's logs, cloud-init's state) reach
# the public snapshot as zeros. Defence in depth, not the guarantee: the
# guarantee is that nothing secret is written to the build disk. What the
# fill cannot reach — the unused tail of a file's last block, directory
# entries, inode and other metadata blocks, the ext4 journal, and the other
# partitions (/boot, /boot/efi) — is listed in docs/design/hardened-image.md.
# EBS root volumes accept no discard (measured), so a trim frees nothing.
#   - ext4 keeps up to 16 MiB (reserved_clusters) even from root; it is set to
#     0 for the fill and put back after;
#   - the fill writes with O_DIRECT, so ext4 allocates blocks (and the file's
#     extent tree) at write time and ENOSPC comes back to dd, never later at
#     writeback; 1 MiB writes, then 4 KiB writes for the last partial MiB;
#   - while the file exists, at most ZERO_FILL_MAX_FREE may be left free;
#   - the file is fsynced with its error checked (`sync FILE`; a bare sync
#     reports none), then removed and the removal synced.
# Fails closed: each pass must end with "No space left on device", the first
# after writing something, and the file must be gone afterwards.
# Nothing else writes to / at this point: journald is on /run, the scrub
# logs to the console, and the services that write were stopped earlier.
ZERO_FILL=/.idlefy-zero-fill
# 1 MiB: after the 4 KiB pass, free space is only what ext4 keeps for the
# fill file's own extent tree — a few 4 KiB blocks. 256 blocks is generous
# for that, and 16 times below the reserve the fill no longer leaves.
ZERO_FILL_MAX_FREE=1048576
zero_fill() {
  local f="$R$ZERO_FILL" out rc=0 size knob saved bsize bfree
  knob=$(resv_knob) || refuse "cannot find the ext4 reserved_clusters of / under /sys/fs/ext4"
  saved=$(cat "$knob" 2>/dev/null) && [[ $saved =~ ^[0-9]+$ ]] || refuse "cannot read $knob"
  sync || refuse "sync before the zero-fill failed"
  rm -f -- "$f" || true
  printf '0\n' | tee "$knob" >/dev/null || refuse "cannot write 0 to $knob"
  RESV_KNOB=$knob RESV_SAVED=$saved
  out=$(LC_ALL=C dd if=/dev/zero of="$f" bs=1M oflag=direct status=none 2>&1) || rc=$?
  if [ "$rc" -eq 0 ] || [[ $out != *"No space left on device"* ]]; then
    rm -f -- "$f" || true
    refuse "zero-fill of / did not end on a full filesystem (dd exit $rc: ${out:-no message})"
  fi
  size=$(stat -c %s "$f" 2>/dev/null) || size=0
  if [ "$size" -le 0 ]; then rm -f -- "$f" || true; refuse "zero-fill of / wrote nothing"; fi
  rc=0
  out=$(LC_ALL=C dd if=/dev/zero of="$f" bs=4K oflag=direct,append conv=notrunc status=none 2>&1) || rc=$?
  if [ "$rc" -eq 0 ] || [[ $out != *"No space left on device"* ]]; then
    rm -f -- "$f" || true
    refuse "zero-fill of / (4 KiB pass) did not end on a full filesystem (dd exit $rc: ${out:-no message})"
  fi
  out=$(sync -- "$f" 2>&1) || { rm -f -- "$f" || true; refuse "fsync of the zero-fill file failed: ${out:-no message}"; }
  read -r bsize bfree < <(stat -f -c '%S %f' "$R/" 2>/dev/null) || true
  if [[ ! $bsize =~ ^[0-9]+$ ]] || [[ ! $bfree =~ ^[0-9]+$ ]]; then
    rm -f -- "$f" || true; refuse "cannot read the free space of / after the zero-fill"
  fi
  if [ $((bsize * bfree)) -gt "$ZERO_FILL_MAX_FREE" ]; then
    rm -f -- "$f" || true; refuse "the zero-fill left $((bsize * bfree)) bytes of / free (at most $ZERO_FILL_MAX_FREE expected)"
  fi
  rm -f -- "$f" || true   # checked below
  sync || refuse "sync after removing the zero-fill failed"
  [ ! -e "$f" ] && [ ! -L "$f" ] || refuse "the zero-fill file $ZERO_FILL is still on disk"
  printf '%s\n' "$saved" | tee "$knob" >/dev/null || refuse "cannot restore $knob to $saved"
  RESV_KNOB=""
}

# Hook 3, immediately before the shared scrub's cloud-init clean, on the disk
# Packer is about to snapshot; it ends with its own clean and the zero-fill. Paths under $R; the root-ownership check only on a real root,
# since a test's fake root cannot be chowned.
solo_check() {
  local f g grp st mode own eic
  local h=/usr/local/sbin/idlefy-share
  # 1. The oneshot that strips cloud-init's re-grants to ubuntu on first boot.
  #    Enabled on the disk: `enabled-runtime` lives in /run, not in the image.
  systemctl is-enabled --quiet idlefy-hardened-firstboot.service \
    || refuse "idlefy-hardened-firstboot.service is not enabled"
  [ -L "$R/etc/systemd/system/multi-user.target.wants/idlefy-hardened-firstboot.service" ] \
    || refuse "idlefy-hardened-firstboot.service has no multi-user.target.wants link on disk"
  # 2. What base::solo bakes and the first boot relies on.
  for f in /etc/cloud/cloud.cfg.d/90-idlefy-hardened.cfg /etc/sudoers.d/50-tailscale-login \
           /etc/sudoers.d/51-idlefy-share "$h"; do
    [ -f "$R$f" ] || refuse "$f is missing"
  done
  # sudoers grants the helper with `*`: whoever can write it is root.
  # The main scrub has no set -E: a bare failure in here would exit with
  # nothing on the console, so every command that can fail names itself.
  mode=$(stat -c %a "$R$h") || refuse "cannot stat $h"
  [ "$mode" = 755 ] || refuse "$h has mode $mode, expected 755"
  if [ -z "$R" ]; then
    own=$(stat -c %u:%g "$h") || refuse "cannot stat $h"
    [ "$own" = 0:0 ] || refuse "$h is owned by $own, expected 0:0"
  fi
  # 3. A sudoers syntax error locks out the admin too.
  visudo -c >/dev/null 2>&1 || refuse "visudo -c rejects the sudoers files"
  # 4. Cloud-init's NOPASSWD grant to ubuntu.
  [ ! -e "$R/etc/sudoers.d/90-cloud-init-users" ] || refuse "/etc/sudoers.d/90-cloud-init-users is present"
  # 5. Whole words, as base::sudoers warns: lxd-installer is not lxd.
  grp=$(id -nG ubuntu) || refuse "cannot read the groups of ubuntu"
  for g in $grp; do
    case $g in sudo | admin | adm | lxd) refuse "ubuntu is in group $g" ;; esac
  done
  # 6. The persisted rules as iptables-save / ip6tables-save write them, in the
  #    filter table only (*filter … COMMIT): the INPUT policy is a chain header
  #    (never a -P line), and base::imds's IMDS drops (`iptables -I OUTPUT <n>
  #    -d 169.254.169.254 -j DROP`, the same for fd00:ec2::254, inserted right
  #    after the owner allows) are saved as OUTPUT rules with /32 and /128.
  for f in /etc/iptables/rules.v4 /etc/iptables/rules.v6; do
    [ -f "$R$f" ] || refuse "$f is missing"
    filter_has "$f" '^:INPUT DROP( |$)' || refuse "$f has no INPUT DROP policy in a committed *filter"
  done
  filter_has /etc/iptables/rules.v4 '^-A OUTPUT -d 169\.254\.169\.254/32 -j DROP$' \
    || refuse "/etc/iptables/rules.v4 does not drop 169.254.169.254 (IMDS) in a committed *filter OUTPUT"
  filter_has /etc/iptables/rules.v6 '^-A OUTPUT -d fd00:ec2::254/128 -j DROP$' \
    || refuse "/etc/iptables/rules.v6 does not drop fd00:ec2::254 (IMDS v6) in *filter OUTPUT"
  #    Before each drop only root's and Instance Connect's owner allows may
  #    stand; the Instance Connect uid comes from this disk's /etc/passwd
  #    (no such user → root's allow only).
  eic=$(awk -F: '$1 == "ec2-instance-connect" { print $3; exit }' "$R/etc/passwd" 2>/dev/null) || eic=""
  meta_preamble_ok /etc/iptables/rules.v4 169.254.169.254/32 "$eic" \
    || refuse "/etc/iptables/rules.v4 has an OUTPUT rule before its IMDS drop other than root's or Instance Connect's owner allow"
  meta_preamble_ok /etc/iptables/rules.v6 fd00:ec2::254/128 "$eic" \
    || refuse "/etc/iptables/rules.v6 has an OUTPUT rule before its IMDS drop other than root's or Instance Connect's owner allow"
  # 7. snapd is gone, and with it every snap and the SSM agent (its snap was
  #    checked gone in solo_prep): the package, its state, and every unit a
  #    snap or snapd installs. No SSM agent as a package either.
  dpkg_sane
  for f in snapd amazon-ssm-agent; do
    pkg_absent "$f" || refuse "$f still installed, or dpkg cannot say (dpkg-query: '${PKG_SAID:-?}')"
  done
  for f in /var/lib/snapd /snap /usr/bin/snap /usr/lib/snapd/snapd; do
    [ ! -e "$R$f" ] && [ ! -L "$R$f" ] || refuse "$f is still on disk after the snapd purge"
  done
  no_units_left
  # 8. So is CINC (its files on disk were checked in solo_prep, after the
  #    purge). A purged package dpkg still remembers reads not-installed.
  pkg_absent cinc || refuse "cinc still installed, or dpkg cannot say (dpkg-query: '${PKG_SAID:-?}')"
  # 9. /etc/dev-vm ran in solo_dir, before image-revision was written.
  # 10. Last, after every check: cloud-init clean, then zero-fill the free
  #     space of / (zero_fill, above). The clean runs here, not only in the
  #     shared scrub after this hook, so that what it deletes (cloud-init's
  #     state, its copy of the user data, its logs) is freed before the fill
  #     and overwritten by it; the shared scrub's own clean then finds
  #     nothing left to delete. A refusal from here on comes after the clean.
  #     cloud-init holds its two logs open (its log handler, its output tee):
  #     deleting them frees nothing until power-off, but truncating does.
  #     The user data's own script is not held: its last line execs this
  #     scrub, which drops bash's close-on-exec hold on it.
  for f in /var/log/cloud-init.log /var/log/cloud-init-output.log; do
    [ ! -f "$R$f" ] || truncate -s 0 -- "$R$f" || refuse "cannot truncate $f"
  done
  cloud-init clean --logs --machine-id || refuse "cloud-init clean failed"
  no_deleted_open
  zero_fill
}
