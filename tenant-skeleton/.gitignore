# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl

# Per-tenant values (real config, never commit — the .example files are the templates)
tenant.auto.tfvars
backend.hcl
infra/ansible/group_vars/all/tenant.yml
cinc/.chef/knife.rb

# Ansible
*.retry
infra/ansible/inventory.yml

# Ansible-vault secrets and the password that opens them (NEVER commit)
# vault.yml is encrypted, but the entry stays: an accidental `ansible-vault
# decrypt` in place would otherwise make the cleartext committable.
infra/ansible/group_vars/all/vault.yml
.vault_pass

# OS
.DS_Store

# Knife admin key — fetch from the CINC server, never commit
cinc/.chef/admin.pem
cinc/.chef/syntaxcache/
