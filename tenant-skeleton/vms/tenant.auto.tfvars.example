# Per-tenant values for the developer-VMs Terraform root.
#
# Copy this file to `tenant.auto.tfvars` and fill in your own values.
# `tenant.auto.tfvars` is gitignored — never commit your real config.
#
# After editing: `terraform plan` should show changes only if values differ
# from whatever is currently deployed. On a fresh tenant, plan creates
# everything from scratch.

aws_profile     = "your-aws-cli-profile"
route53_zone_id = "Z01234567ABCDEFGHIJKL"

# Policy delivery. There is no CINC server: `cd cinc && make push` exports
# each policy, signs a manifest with your SSH key and writes both to a bucket
# you own; every VM fetches, verifies and converges from it. Any bucket works —
# same account or another one, SSE-S3 or SSE-KMS. The runbook has the bucket
# policy a cross-account bucket needs. A dedicated bucket is recommended.
policy_bucket        = "your-org-dev-vm-policies"
policy_bucket_owner  = "123456789012"
policy_bucket_region = "eu-central-1"
# policy_prefix      = "dev-vm-policies"
# policy_kms_key_arn = "arn:aws:kms:eu-central-1:123456789012:key/..."

# The keys new VMs trust, one allowed_signers line per operator. Twin of
# `default['base']['policy']['signers']` in cinc/policyfiles/dev-vm.rb —
# `cd cinc && make preflight` fails if they disagree. Give CI only the staging
# namespace, so it can never publish to production.
policy_signers = [
  "you@example.com namespaces=\"dev-vm-policy-staging,dev-vm-policy-production\" ssh-ed25519 AAAA...",
]
# Raise to a security fix's serial so no VM, new or running, accepts anything older.
# policy_min_serial = 0

# Log shipping to Grafana Cloud Loki. This flag and
# `default['base']['loki']['enabled']` in cinc/policyfiles/dev-vm.rb are ONE
# decision: `cd cinc && make preflight` fails if they disagree. Not using
# Grafana Cloud? Set log_shipping = false and loki_ssm_parameter_name = null.
log_shipping            = true
loki_ssm_parameter_name = "/developer-vms/observability/loki-token"

# Idlefy. Every VM is tagged `idlefy = "enabled"` so Idlefy can find it and
# stop/start/reboot it on your schedule — the tag is a label, the platform grants
# Idlefy nothing; Idlefy's own role is what you connect at https://idlefy.com.
# false ⇒ the platform adds no `idlefy` tag (a VM's own `tags` still apply).
# To opt a single VM out instead, give it `tags = { idlefy = "disabled" }` in
# instances.auto.tfvars.
idlefy_managed = true
