#!/bin/sh
# dev-vm-policy-run — the unit's ExecStart. Runs dev-vm-policy-fetch, and if
# that exits with anything but one of its documented codes, runs the previous
# version instead.
#
# Only user_data writes this file; the cookbook never does. The cookbook
# replaces dev-vm-policy-fetch itself (via .new and --self-test, keeping
# .prev), so a broken fetch shipped in a revision could otherwise never run
# the converge that repairs it. Falling back costs nothing in safety: .prev
# makes every check the current version makes.

FETCH=${DEV_VM_POLICY_FETCH:-/usr/local/sbin/dev-vm-policy-fetch}

"$FETCH" "$@"
rc=$?
case "$rc" in
  0|11|12|13|14) exit "$rc" ;;
esac
if [ -x "$FETCH.prev" ]; then
  echo "dev-vm-policy-run: $FETCH exited $rc; running the previous version" >&2
  "$FETCH.prev" "$@"
  exit $?
fi
exit "$rc"
