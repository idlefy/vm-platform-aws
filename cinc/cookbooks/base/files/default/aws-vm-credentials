#!/usr/bin/env bash
#
# Publish short-lived credentials for this VM's identity role.
#
# Managed by CINC base::aws_access — do NOT edit on the VM, it is overwritten
# on the next converge.
#
# Runs as root from aws-vm-credentials.timer. Reads its per-VM config from
# /etc/dev-vm/aws-access.env (root-only), reads the identity role ARN from this
# VM's SSM access parameter using the instance's bootstrap role, assumes the
# identity role, and publishes an ini credentials file the developer can read.
#
# Safety properties that must not be lost:
#   * The output directory is root-owned and NOT writable by the developer, so a
#     temp file created inside it cannot be pre-empted by a symlink. This is
#     VERIFIED below, not assumed — see the check_out_dir comment.
#   * Publishing is a single rename(2), so a partial file is never visible.
#   * Any failure leaves the previous credentials in place rather than
#     truncating them.
#
# Why /dev/shm and not /run: rootless Docker is started by RootlessKit with
# copy-up=/run, which gives the daemon a private tmpfs at /run inside its mount
# namespace. A bind mount of /run/aws-vm into a container therefore resolves to
# an empty directory and the credentials are invisible — which defeats one of the
# two reasons this broker exists, since rootless containers cannot reach IMDS
# either. /dev/shm is also tmpfs (so credentials still never touch disk) and is
# not copied up, so containers see it live. Verified on a real VM.
#
# AWS_VM_ENV_FILE / AWS_VM_OUT_DIR exist so test/test-aws-vm-credentials.sh can
# exercise this script without root and without AWS.

set -euo pipefail

ENV_FILE=${AWS_VM_ENV_FILE:-/etc/dev-vm/aws-access.env}
OUT_DIR=${AWS_VM_OUT_DIR:-/dev/shm/dev-vm-aws}

if [ ! -e "$ENV_FILE" ] && [ ! -L "$ENV_FILE" ]; then
  echo "aws-vm-credentials: $ENV_FILE not present; nothing to do"
  exit 0
fi

# The env file is sourced as shell, so it is executed as root. It lives in a
# root-owned directory, but that directory's ownership is itself something a
# converge could get wrong (a symlink-following chown was found in review), so
# refuse anything that is not a regular, owner-only-writable file owned by us —
# the same property the output-directory guard below asserts, for the same
# reason. Under the unprivileged test harness "us" is the test user.
if [ -L "$ENV_FILE" ] || [ ! -f "$ENV_FILE" ]; then
  echo "aws-vm-credentials: $ENV_FILE is a symlink or not a regular file; refusing to source it" >&2
  exit 1
fi
# Open the file once and check the inode actually held, then source through
# the descriptor: whatever is swapped in at the path between the check and the
# read is not what gets executed.
exec 3< "$ENV_FILE" || {
  echo "aws-vm-credentials: cannot open $ENV_FILE; refusing to continue" >&2
  exit 1
}
if [ ! -f /proc/self/fd/3 ]; then
  echo "aws-vm-credentials: $ENV_FILE is not a regular file; refusing to source it" >&2
  exit 1
fi
env_uid=$(stat -L -c '%u' /proc/self/fd/3)
env_mode=$(stat -L -c '%a' /proc/self/fd/3)
if [ "$env_uid" != "$(id -u)" ]; then
  echo "aws-vm-credentials: $ENV_FILE is owned by uid ${env_uid}, not $(id -u); refusing to source it" >&2
  exit 1
fi
if [ $(( 0"$env_mode" & 022 )) -ne 0 ]; then
  echo "aws-vm-credentials: $ENV_FILE is mode ${env_mode}, writable beyond its owner; refusing to source it" >&2
  exit 1
fi

# shellcheck source=/dev/null
. /proc/self/fd/3
exec 3<&-

: "${VM_NAME:?VM_NAME missing from $ENV_FILE}"
: "${REGION:?REGION missing from $ENV_FILE}"
: "${UBUNTU_GID:?UBUNTU_GID missing from $ENV_FILE}"

PARAM="/developer-vms/access/${VM_NAME}"

# The output directory is the only thing standing between a root writer and a
# path the developer controls, so verify it instead of trusting it.
#
# This matters more under /dev/shm than it did under /run. /dev/shm is mode 1777,
# so the developer CAN create entries there. systemd-tmpfiles creates our
# directory early at boot and wins that race in practice, and /dev/shm's sticky
# bit then stops the developer removing or renaming a root-owned directory — but
# "in practice" is not a security argument, and the failure is silent: root would
# happily publish credentials into a directory the developer owns and can swap
# entries in.
#
# The property asserted is "the writer owns this directory and nobody else can
# write to it", which is exactly right as root and is also what makes the check
# testable unprivileged: under the test harness the owner is the test user.
if [ -L "$OUT_DIR" ] || [ ! -d "$OUT_DIR" ]; then
  echo "aws-vm-credentials: $OUT_DIR is missing, not a directory, or a symlink; refusing to publish" >&2
  exit 1
fi

dir_uid=$(stat -c '%u' "$OUT_DIR")
dir_mode=$(stat -c '%a' "$OUT_DIR")

if [ "$dir_uid" != "$(id -u)" ]; then
  echo "aws-vm-credentials: $OUT_DIR is owned by uid ${dir_uid}, not $(id -u); refusing to publish" >&2
  exit 1
fi

# Reject group- or other-writable. 0750 passes, 0775 and 0757 do not.
if [ $(( 0"$dir_mode" & 022 )) -ne 0 ]; then
  echo "aws-vm-credentials: $OUT_DIR is mode ${dir_mode}, writable beyond its owner; refusing to publish" >&2
  exit 1
fi

umask 027

# stderr goes to its own file rather than being folded into the captured value
# with 2>&1 — any warning the AWS CLI writes to stderr would otherwise be
# concatenated into the JSON and break the jq parse below.
#
# It lives in OUT_DIR, not /tmp: this runs as root and /tmp is world-writable,
# and OUT_DIR is the one directory guaranteed writable by us and by nobody else.
# Sweep any temp files a previous run left behind. Bash does not run an EXIT trap
# when it dies from an untrapped signal, so a systemd TimeoutStartSec kill leaks
# them, and nothing else ever cleans OUT_DIR. Safe to glob-remove: the directory
# is root-owned and excludes the developer, which is the same property that makes
# the rename below safe.
rm -f "${OUT_DIR}"/.stderr.* "${OUT_DIR}"/.credentials.*

err=$(mktemp "${OUT_DIR}/.stderr.XXXXXX")
trap 'rm -f "$err"' EXIT INT TERM

# Missing or unreadable parameter is not an error: it means terraform apply has
# not run yet for this VM. Exit 0 so systemd does not flag a failure, and leave
# any existing credentials alone.
if ! param_json=$(aws ssm get-parameter \
                    --name "$PARAM" \
                    --region "$REGION" \
                    --query 'Parameter.Value' \
                    --output text 2>"$err"); then
  echo "aws-vm-credentials: cannot read $PARAM ($(tr -d '\n' < "$err")); leaving existing credentials in place"
  exit 0
fi

role_arn=$(printf '%s' "$param_json" | jq -er '.identity_role_arn')
session=$(printf '%s' "$param_json" | jq -er '.session_name')

# A freshly created IAM role is not immediately assumable — IAM is eventually
# consistent. Retry briefly so a brand-new VM does not wait for the next timer
# tick. Never request more than 3600s: this call is role chaining (the caller is
# an instance profile), and AWS caps chained sessions at one hour.
creds=""
for attempt in 1 2 3 4 5; do
  if creds=$(aws sts assume-role \
               --role-arn "$role_arn" \
               --role-session-name "$session" \
               --source-identity "$session" \
               --duration-seconds 3600 \
               --region "$REGION" \
               --output json 2>"$err"); then
    break
  fi
  if [ "$attempt" -eq 5 ]; then
    echo "aws-vm-credentials: assume-role on $role_arn failed after 5 attempts: $(tr -d '\n' < "$err")" >&2
    exit 1
  fi
  sleep $((attempt * 5))
done

# Validate before rendering. jq treats `"x = " + null` as "x = " and exits 0 —
# null is the identity for +, and -e only inspects the last output value. So an
# STS response that parses but is missing a field would otherwise replace a
# WORKING credentials file with one containing an empty secret key, and the
# developer would see SignatureDoesNotMatch while the timer, the journal and the
# file mtime all look healthy.
if ! printf '%s' "$creds" | jq -e '
      .Credentials
      | (.AccessKeyId | type == "string" and length > 0)
        and (.SecretAccessKey | type == "string" and length > 0)
        and (.SessionToken   | type == "string" and length > 0)
    ' >/dev/null; then
  echo "aws-vm-credentials: assume-role returned an incomplete credential set; leaving existing credentials in place" >&2
  exit 1
fi

tmp=$(mktemp "${OUT_DIR}/.credentials.XXXXXX")
trap 'rm -f "$tmp" "$err"' EXIT INT TERM

chmod 0640 "$tmp"
# Only root can hand a file to another group owner. Skipped under the test
# harness, which runs unprivileged; the real ownership is asserted on the VM.
if [ "$(id -u)" -eq 0 ]; then
  chown "root:${UBUNTU_GID}" "$tmp"
fi

printf '%s' "$creds" | jq -er '
  "[default]",
  "aws_access_key_id = "     + .Credentials.AccessKeyId,
  "aws_secret_access_key = " + .Credentials.SecretAccessKey,
  "aws_session_token = "     + .Credentials.SessionToken
' > "$tmp"

mv -f "$tmp" "${OUT_DIR}/credentials"
rm -f "$err"
trap - EXIT

echo "aws-vm-credentials: published session '${session}' for ${role_arn}"
